# Copy to .env (repo root) and to apps/web/.env.local.
# Values below are the fixed defaults printed by `pnpm db:start`.

# Direct Postgres connection used by server code, migrations and tests.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API (auth). Run `pnpm exec supabase status` to see the publishable (or anon) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
